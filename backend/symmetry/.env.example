SYMMETRY_ENV=development
SYMMETRY_APP_NAME=Symmetry API
SYMMETRY_API_PREFIX=/v1
SYMMETRY_DEV_ADMIN_TOKEN=
SYMMETRY_DEV_USAGE_DEFAULT_DAYS=7
SYMMETRY_DEV_USAGE_MAX_ROWS=1000
SYMMETRY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/symmetry
SYMMETRY_JWT_SECRET=change-me
SYMMETRY_JWT_ALGORITHM=HS256
SYMMETRY_ACCESS_TOKEN_TTL_MINUTES=30
SYMMETRY_REFRESH_TOKEN_TTL_DAYS=30
SYMMETRY_SERVER_LLM_BASE_URL=https://api.deepseek.com/v1
SYMMETRY_SERVER_LLM_MODEL=deepseek-v4-flash
SYMMETRY_SERVER_LLM_API_KEY=
SYMMETRY_SERVER_LLM_TIMEOUT_SECONDS=90
SYMMETRY_EMBEDDING_MODEL=intfloat/multilingual-e5-base
SYMMETRY_EMBEDDING_BACKEND=onnx
SYMMETRY_EMBEDDING_MODEL_FILE_NAME=onnx/model.onnx
SYMMETRY_EMBEDDING_MODEL_DIR=models
SYMMETRY_EMBEDDING_BATCH_SIZE=32
SYMMETRY_EMBEDDING_CACHE_SIZE=256
SYMMETRY_EMBEDDING_CACHE_TTL_SECONDS=300
SYMMETRY_RAG_TOP_K=5
SYMMETRY_RAG_HNSW_EF_SEARCH=40
SYMMETRY_MEMORY_IMPORTANCE_THRESHOLD=7
SYMMETRY_YANDEX_CLIENT_ID=
SYMMETRY_YANDEX_CLIENT_SECRET=
SYMMETRY_YANDEX_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/yandex/callback
SYMMETRY_WEB_PUBLIC_ORIGIN=http://127.0.0.1:3010
SYMMETRY_YANDEX_AUTHORIZE_URL=https://oauth.yandex.ru/authorize
SYMMETRY_YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
SYMMETRY_YANDEX_USERINFO_URL=https://login.yandex.ru/info
SYMMETRY_API_VERSION=2.0
SYMMETRY_RELEASE_ID=dev-local
SYMMETRY_RELEASED_AT=2026-04-07T00:00:00Z
SYMMETRY_WEB_LATEST_VERSION=1.0.0+1
SYMMETRY_WEB_MINIMUM_SUPPORTED_VERSION=1.0.0+1
SYMMETRY_WEB_ASSET_VERSION=dev-local
SYMMETRY_WEB_UPDATE_MESSAGE=A new web version is available.
SYMMETRY_DESKTOP_LATEST_VERSION=1.0.0+1
SYMMETRY_DESKTOP_MINIMUM_SUPPORTED_VERSION=1.0.0+1
SYMMETRY_DESKTOP_UPDATE_URL=
SYMMETRY_DESKTOP_UPDATE_MESSAGE=A new desktop version is available.
SYMMETRY_FEEDBACK_RECIPIENT_EMAIL=a@svc-code.ru
SYMMETRY_FEEDBACK_SENDER_EMAIL=a@svc-code.ru
SYMMETRY_FEEDBACK_EMAIL_SUBJECT_PREFIX=Landing feedback
SYMMETRY_FEEDBACK_SMTP_HOST=
SYMMETRY_FEEDBACK_SMTP_PORT=465
SYMMETRY_FEEDBACK_SMTP_USERNAME=
SYMMETRY_FEEDBACK_SMTP_PASSWORD=
SYMMETRY_FEEDBACK_SMTP_USE_SSL=true
SYMMETRY_FEEDBACK_SMTP_USE_STARTTLS=false
